---
LOCATION: "Swansea"
TIDE_LOCATION: "Swansea"
MYNODE: "3663493700"
MYNODES:
  - "3663493700"
  - "1234567890"
DBFILENAME: "./db/nodes.db"
DM_MODE: True
FIREWALL: True
DUTYCYCLE: True
BOT_NAME: "WeMoBot"
WELCOME_ENABLED: False
WELCOME_MESSAGE: "🤖 Welcome {long_name} ({short_name}) to the mesh! - {bot_name}"
# WELCOME_DB: "./db/welcome.db"
# WELCOME_COOLDOWN_DAYS: 30

# Optional: current conditions via nearest NWS observation station
# WEATHER_LAT: 30.6954
# WEATHER_LON: -88.0399

# METAR observation (aviation weather, terse format)
METAR_STATION: "KMOB"

# Daily tropics broadcast during hurricane season (Jun–Nov)
TROPICS_DAILY_ENABLED: True
TROPICS_DAILY_TIME: "07:00"   # CT — broadcast ~7am

# Daily morning forecast broadcast (same data source as #weather)
FORECAST_DAILY_ENABLED: True
FORECAST_DAILY_TIME: "07:00"   # CT

# Optional: operator-only node status (#status).
# OPERATOR_NODE is the node number allowed to run #status (your own node).
# STATUS_NODES is the list of node numbers the operator monitors.
# If OPERATOR_NODE is unset, #status is inert (silently ignored).
# OPERATOR_NODE: "3770480103"
# STATUS_NODES:
#   - "3661660496"   # WeMoBot
#   - "3770480103"   # Tomp (operator)
#   - "1578062984"   # WeMo Reapeater 1 (solar router)
